# Server
PORT=5000

# MongoDB — create a free cluster at https://www.mongodb.com/atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/duohabit

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins (the React dev server / deployed frontend)
CLIENT_URL=http://localhost:5173